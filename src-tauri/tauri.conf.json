{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OperasionalAutomationApp",
  "version": "1.0.0",
  "identifier": "com.bahanasecurity.operasional.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PT Bahana Security Sistem - Operational Automation",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
